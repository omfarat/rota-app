{
  "name": "rota-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/**/*.test.ts scripts/*.test.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:offline": "node scripts/offline-test.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "verify:links": "node scripts/verify-links.mjs",
    "verify:images": "node scripts/verify-images.mjs",
    "data": "node scripts/fetch-data.mjs",
    "images": "node scripts/fill-images.mjs",
    "images:credits": "node scripts/fill-credits.mjs",
    "images:mapillary": "node scripts/fill-mapillary.mjs",
    "data:clear": "node -e \"require('fs').rmSync('.cache',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "config": {
    "playwright_skip_browser_download": "1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
